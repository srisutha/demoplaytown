# Folder that holds the existing app_playtown files (HTML/JS/assets, uploads,
# assets/json data files). Defaults to ../app_playtown.
PLAYTOWN_APP_DIR=

# Main MySQL database (was app_playtown/db.php). Schema is unchanged.
DB_HOST=localhost
DB_PORT=3306
DB_USER=yuha_demo_playtown_app
DB_PASSWORD=
DB_NAME=yuha_demo_playtown_app
# PHP used the server's default connection charset; set this to match
# `character_set_server` if non-ASCII text looks wrong.
DB_CHARSET=utf8mb4

# Human-chain MySQL database (uploadchain.php, admin/, fetch_humanchainusers.php)
HC_DB_HOST=localhost
HC_DB_USER=playtown_humanchain
HC_DB_PASSWORD=
HC_DB_NAME=playtown_humanchain

# AWS (DynamoDB, S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_REGION_SOUTH=ap-south-1
# upload_dynamodb.php and humanchain_dynamodb/ used us-east-1
AWS_LEGACY_REGION=us-east-1
AWS_S3_BUCKET_NAME=playtown

# Mailgun (certificate e-mails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mpurl.in

# SMS gateway (panel.smsmessenger.in)
SMS_USER=mediaworks
SMS_PASSWORD=

# VanceAI (AI caricature)
VANCE_AI_API_TOKEN=

# app_playtown/admin/login.php
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Random string, at least 32 characters (encrypts the session cookie)
SESSION_SECRET=
